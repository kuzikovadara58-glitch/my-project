# Пример файла для ЛОКАЛЬНОЙ РАЗРАБОТКИ.
# Реальные значения сюда не вписывать и не коммитить (.env исключён в .gitignore).
# В продакшне логин и пароль хранятся в системном хранилище учётных данных ОС
# (см. journal_automation/secrets.py), .env — только резервный вариант для разработки
# и включается явно переменной JOURNAL_ALLOW_DOTENV_SECRETS=1.

JOURNAL_URL=
JOURNAL_LOGIN=
JOURNAL_PASSWORD=

# Опционально — включает чтение секретов из .env вместо системного хранилища
# (только для локальной разработки).
JOURNAL_ALLOW_DOTENV_SECRETS=0
