# --- Виртуальное окружение и Python-артефакты ---
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo

# --- Секреты и окружение разработки ---
# В продакшне секреты (логин/пароль от журнала) хранятся ТОЛЬКО в системном
# хранилище учётных данных ОС (Windows Credential Manager через keyring).
# .env допустим исключительно для локальной разработки и никогда не коммитится.
.env
.env.*
!.env.example
*.secret
secrets.yaml
credentials.json

# --- Сессии и авторизация браузера (Playwright) ---
storage_state.json
*.session
.auth/

# --- Пользовательские данные приложения ---
# База данных, реальные фотографии, реальные списки спортсменов и локальные
# конфиги хранятся отдельно от установленной программы и никогда не попадают
# в репозиторий. В репозитории допустимы только examples/ с вымышленными данными.
data/
user_data/
*.db
*.db-journal
*.sqlite
*.sqlite3
photos/
media/
config/local.yaml
config/real_*.yaml

# --- Логи и диагностика ---
# Могут содержать персональные данные (ФИО спортсменов, фрагменты страниц журнала).
logs/
*.log
diagnostics/
screenshots/
*.trace.zip
playwright-report/
test-results/

# --- Сборка и дистрибутив ---
build/
dist/

# --- IDE и инструменты ---
.idea/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
